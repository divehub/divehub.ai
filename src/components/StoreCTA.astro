---
interface Props {
  compact?: boolean;
  class?: string;
}
const { compact = false, class: className } = Astro.props;
---

<a
  class:list={['store-cta', { compact }, className]}
  href="https://apps.apple.com/us/app/divehub-multi-dive-tool/id6756101582"
  aria-label="Download DiveHub on the App Store"
>
  <svg class="apple-mark" viewBox="0 0 384 512" width="26" height="30" fill="currentColor" aria-hidden="true">
    <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5c0 26.2 4.8 53.3 14.4 81.2 12.8 36.7 59 126.5 107.2 125 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.2 17.9 76.4 17.9 48.6-.7 90.5-82.3 102.7-119.1-65.2-30.7-61.8-90-61.8-91.9ZM262.1 104.5c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 72.2 26.1 2 49.9-11.4 69.5-34.6Z" />
  </svg>
  <span class="store-copy"><span>Download on the</span><strong>App Store</strong></span>
</a>

<style>
  .store-cta {
    display: inline-flex;
    width: fit-content;
    min-height: 56px;
    align-items: center;
    justify-content: center;
    gap: 11px;
    padding: 9px 18px;
    border: 1px solid #73828c;
    border-radius: 11px;
    background: #000;
    color: #fff;
    transition: border-color 160ms ease, background-color 160ms ease;
  }

  .store-cta:hover {
    border-color: var(--color-accent);
    background: #071218;
  }

  .apple-mark {
    width: 26px;
    height: 30px;
    flex-shrink: 0;
  }

  .store-copy {
    display: grid;
    gap: 2px;
    text-align: left;
    line-height: 1;
  }

  .store-copy > span {
    font-size: 10px;
    letter-spacing: 0.01em;
  }

  .store-copy strong {
    font-size: 23px;
    font-weight: 500;
    letter-spacing: -0.035em;
  }

  .compact {
    min-height: 48px;
    padding: 8px 14px;
    gap: 9px;
  }

  .compact .apple-mark {
    width: 22px;
    height: 26px;
  }

  .compact .store-copy strong {
    font-size: 20px;
  }
</style>
